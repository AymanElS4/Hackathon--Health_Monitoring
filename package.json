{
  "name": "base-vital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "libs/*",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @base-vital/frontend",
    "test": "npm test --workspaces --if-present",
