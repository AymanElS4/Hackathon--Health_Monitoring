# Base Vital - environment template for the local stack (docker compose).
#
# Setup: copy this file to `.env` and fill in every required value. Never commit `.env`.
# Every value is required unless it is marked optional.
# `docker compose up` refuses to start and names any required variable that is missing or empty.
#
# Required: fill in each value below.

# Postgres superuser name.
POSTGRES_USER=

# Postgres password. Use only letters, digits, `-` and `_`, because it is placed inside the database URL.
POSTGRES_PASSWORD=

# Postgres database name.
POSTGRES_DB=

# Shared code typed in the flight-surgeon page. At least 12 characters. Must differ from SYNC_CODE.
SURGEON_ACCESS_CODE=

# Shared code the crew tablet sends with each check-in. At least 12 characters.
SYNC_CODE=

# Optional: comma-separated origins allowed to call the API. Default: https://base-vital.pages.dev
# CORS_ORIGINS=

# Optional: host ports, bound to 127.0.0.1 only. Defaults: 3000, 5432 and 4173.
# BACKEND_HOST_PORT=
# POSTGRES_HOST_PORT=
# FRONTEND_HOST_PORT=
